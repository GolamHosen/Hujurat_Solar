# ============================================================
# HUJURAT SOLAR PLATFORM — ENVIRONMENT VARIABLES (TEMPLATE)
# Copy this file to .env and fill in your values.
# ============================================================

# 1) MAIN DATABASE — Supabase Pooler connection string (port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# 2) DIRECT CONNECTION — Supabase direct string (port 5432, for migrations)
DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# 3) SUPABASE CLIENT (optional — only for Supabase Auth/Storage)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# 4) TURSO DATABASE (libSQL/SQLite — NOT compatible with the current pg schema)
TURSO_DATABASE_URL=libsql://<database-name>-<org>.turso.io
TURSO_AUTH_TOKEN=

# 5) APP SECRETS & CONFIG
SESSION_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 5b) CLOUDINARY (Media Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=


# 6) SEO — SEARCH ENGINE VERIFICATION (optional)
# Google Search Console: Add property -> HTML tag -> copy the value inside content="..."
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools: HTML meta tag msvalidate.01 -> copy the content value
BING_SITE_VERIFICATION=

# ============================================================
# 7) SECURITY SETTINGS ADDED BY THE SECURITY REVIEW (see SECURITY.md)
# ============================================================

# Admin session lifetime in hours (default 24, maximum 720).
SESSION_TTL_HOURS=24

# Extra hosts next/image may optimise (comma separated). The site host plus
# *.supabase.co / *.supabase.in are always allowed. NEVER use "**".
NEXT_PUBLIC_IMAGE_HOSTS=

# Extra origins allowed to invoke Server Actions. Only needed behind a proxy/CDN
# that rewrites Host/Origin headers.
SERVER_ACTION_ALLOWED_ORIGINS=

# --- Database TLS -------------------------------------------------
# Verification is ON by default. Download YOUR provider root certificate
# (Supabase: Project Settings -> Database -> SSL configuration) and point
# DATABASE_SSL_CA_FILE at the file:
#   DATABASE_SSL_CA_FILE=./certs/supabase-root.crt
DATABASE_SSL_CA_FILE=
# Inline PEM alternative (use literal \n for newlines).
DATABASE_SSL_CA=
# TEMPORARY ONLY: skips certificate verification. Logs a warning on start.
# Prefer DATABASE_SSL_CA_FILE.
DATABASE_SSL_NO_VERIFY=false

# --- Content-Security-Policy -------------------------------------
# Set to "off" only as an emergency escape hatch.
SECURITY_CSP=on

# --- First admin account (scripts/seed.ts) -----------------------
ADMIN_EMAIL=admin@hujuratsolar.com.au
ADMIN_PASSWORD=
