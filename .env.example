# ============================================================
# HUJURAT SOLAR PLATFORM — ENVIRONMENT VARIABLES TEMPLATE
# ============================================================
# Copy this file to .env for local development:
#   cp .env.example .env
# For Vercel deployment, configure these in:
#   Vercel Dashboard → Project Settings → Environment Variables

# ------------------------------------------------------------
# 1) POSTGRESQL DATABASE (Drizzle ORM)
# ------------------------------------------------------------
# Supabase Dashboard → Project Settings → Database → Connection string
# For production and serverless (Vercel), use the transaction-mode Pooler (port 6543):
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Direct connection (port 5432) for running migrations or drizzle-kit CLI:
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# Optional: Custom Pool max size (auto-defaults to 2 on Vercel/serverless, 10 in standard Node.js)
# DATABASE_POOL_MAX=2

# Optional: Database TLS Root CA (Supabase Root 2021 CA is already built-in, but you can override here)
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# DATABASE_SSL_CA_FILE="./certs/prod-ca-2021.crt"

# ------------------------------------------------------------
# 2) AUTHENTICATION & SECURITY
# ------------------------------------------------------------
# Secret key used to sign and verify admin session JWTs.
# MUST be at least 32 characters long. Generate via: openssl rand -base64 32
SESSION_SECRET="generate-a-strong-random-secret-key-at-least-32-chars-long"

# Session expiration time in hours (default: 24)
SESSION_TTL_HOURS=24

# ------------------------------------------------------------
# 3) PUBLIC SITE URL (SEO & Server Action Security)
# ------------------------------------------------------------
# Local: http://localhost:3000
# Vercel: https://your-domain.vercel.app or https://www.hujuratsolar.com.au
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: Extra origins allowed for Server Actions (comma-separated).
# Note: *.vercel.app is already automatically allowed on Vercel deployments.
# SERVER_ACTION_ALLOWED_ORIGINS="https://www.hujuratsolar.com.au"

# ------------------------------------------------------------
# 4) CLOUDINARY (Media Storage & Uploads)
# ------------------------------------------------------------
# Required for media uploads on Vercel (serverless filesystem is read-only).
# Cloudinary Dashboard → Settings → Access Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Or single connection URL format:
# CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"

# ------------------------------------------------------------
# 5) ADMIN SEEDING (Optional)
# ------------------------------------------------------------
# Used by `npm run seed` to provision the initial administrator account.
ADMIN_EMAIL="admin@hujuratsolar.com.au"
ADMIN_PASSWORD=""

# ------------------------------------------------------------
# 6) SEARCH CONSOLE VERIFICATION (Optional)
# ------------------------------------------------------------
# GOOGLE_SITE_VERIFICATION="your-google-verification-code"
# BING_SITE_VERIFICATION="your-bing-verification-code"
