# ============================================================
# HUJURAT SOLAR PLATFORM — ENVIRONMENT VARIABLES TEMPLATE
# ============================================================

# 1) MAIN DATABASE (Supabase Transaction Pooler, Port 6543)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# 2) DIRECT DATABASE (Supabase Direct, Port 5432 for migrations)
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# 3) APP SECRETS & CONFIG
SESSION_SECRET="your-32-character-or-longer-random-secret"
NEXT_PUBLIC_SITE_URL="https://www.hujuratsolar.com.au"

# 4) CLOUDINARY CONFIGURATION
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_URL=""

# 5) DATABASE TLS
DATABASE_SSL_CA_FILE="./certs/prod-ca-2021.crt"

# 6) SMTP EMAIL CONFIGURATION (Nodemailer)
# Gmail, Outlook, Resend, or your custom domain SMTP (Titan/cPanel)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="info@hujuratsolar.com.au"
SMTP_PASS="your-app-password"
SMTP_FROM="Hujurat Solar <info@hujuratsolar.com.au>"
SMTP_TO="info@hujuratsolar.com.au"
